{
  "name": "gastos-frontend",
  "version": "1.5.7",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "ng": "ng",
    "prebuild": "node scripts/write-firebase-api-key.mjs && node scripts/write-api-key.mjs && node scripts/generate-sitemap.mjs",
    "build:staging": "node scripts/apply-staging-robots.mjs && pnpm run build",
    "format": "prettier --write \"src/**/*.{ts,js,mjs,json,scss,css,html}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,mjs,json,scss,css,html}\"",
    "lint": "ng lint web",
    "lint:ci": "ng lint web --max-warnings=0",
    "pretest": "node scripts/write-firebase-api-key.mjs && node scripts/write-api-key.mjs",
    "prestart": "node scripts/write-firebase-api-key.mjs && node scripts/write-api-key.mjs",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "mobile:sync": "cap sync android",
    "mobile:open": "cap open android",
    "mobile:build": "npm run build && npm run mobile:sync && npm run mobile:open",
    "mobile:live": "ng serve --host 0.0.0.0",
    "mobile:publish-apk": "node scripts/publish-mobile-apk.mjs",
    "serve:ssr:web": "node dist/web/server/server.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.3.33",
    "@angular/compiler": "^20.3.33",
    "@angular/core": "^20.3.33",
    "@angular/forms": "^20.3.33",
    "@angular/platform-browser": "^20.3.33",
    "@angular/platform-browser-dynamic": "^20.0.0",
    "@angular/platform-server": "^20.3.33",
    "@angular/router": "^20.3.33",
    "@angular/ssr": "^20.3.37",
    "@capacitor-firebase/authentication": "^8.5.2",
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/share": "^8.0.3",
    "chart.js": "^4.4.7",
    "express": "^5.1.0",
    "firebase": "^12.19.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.37",
    "@angular-eslint/builder": "^20.0.0",
    "@angular-eslint/eslint-plugin": "^20.0.0",
    "@angular-eslint/eslint-plugin-template": "^20.0.0",
    "@angular-eslint/schematics": "^20.0.0",
    "@angular-eslint/template-parser": "^20.0.0",
    "@angular/cli": "^20.3.37",
    "@angular/compiler-cli": "^20.3.33",
    "@eslint/js": "^9.0.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/express": "^5.0.1",
    "@types/jasmine": "~7.0.0",
    "@types/node": "^26.6.4",
    "angular-eslint": "^20.0.0",
    "eslint": "^9.0.0",
    "jasmine-core": "~7.0.2",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.3.0",
    "postcss": "^8.5.28",
    "prettier": "^3.0.0",
    "tailwindcss": "^4.1.11",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0"
  }
}